@model List<HelpDeskWeb.Models.TicketPriority>

<h1>Ticket Priority</h1>

<div class="row">
    <div class="col-12">
        <a asp-controller="TicketPriority" asp-action="Create" class="btn btn-primary">
            Crear Nuevo Ticket Priority
        </a>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>            
                    <th>Created At</th>
                    <th>Updated At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>                
                        <td>@item.CreatedAt</td>
                        <td>@item.UpdatedAt</td>
                        <td>
                            <a asp-controller="TicketPriority" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">
                                Editar
                            </a>
                            <form asp-controller="TicketPriority" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este registro?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
