@model List<HelpDeskWeb.Models.Ticket>

<h1>Mis Tickets</h1>

<div class="row">
    <div class="col-12">
        <a asp-controller="Ticket" asp-action="CreateUserTicket" class="btn btn-primary">Nuevo Ticket</a>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Ticket</th>
                    <th>Título</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                    <th>Creado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TicketNumber</td>
                        <td>@item.Title</td>
                        <td>@item.Status?.Name</td>
                        <td>@item.Priority?.Name</td>
                        <td>@item.CreatedAt</td>
                        <td>
                            <a asp-controller="Ticket" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
