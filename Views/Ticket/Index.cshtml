@model List<HelpDeskWeb.Models.Ticket>

<h1>Tickets</h1>

<div class="row">
    <div class="col-12">
        <a asp-controller="Ticket" asp-action="Create" class="btn btn-primary">Crear Nuevo Ticket</a>
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Ticket Number</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Assigned To</th>
                    <th>Created At</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TicketNumber</td>
                        <td>@item.Title</td>
                        <td>@item.Status?.Name</td>
                        <td>@item.Priority?.Name</td>
                        <td>@item.AssignedTo?.FullName</td>
                        <td>@item.CreatedAt</td>
                        <td>
                            <a asp-controller="Ticket" asp-action="Details" asp-route-id="@item.Id" class="btn btn-secondary">Detalles</a>
                            <a asp-controller="Ticket" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Editar</a>
                            <form asp-controller="Ticket" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este ticket?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
