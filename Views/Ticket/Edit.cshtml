@model HelpDeskWeb.Models.Ticket

<h1>Editar Ticket</h1>

<form asp-controller="Ticket" asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="TicketNumber" class="form-label"></label>
        <input asp-for="TicketNumber" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StatusId" class="form-label">Status</label>
        <select asp-for="StatusId" class="form-select" asp-items='@(new SelectList((List<HelpDeskWeb.Models.TicketStatus>)ViewData["Statuses"], "Id", "Name", Model.StatusId))'></select>
    </div>

    <div class="mb-3">
        <label asp-for="PriorityId" class="form-label">Priority</label>
        <select asp-for="PriorityId" class="form-select" asp-items='@(new SelectList((List<HelpDeskWeb.Models.TicketPriority>)ViewData["Priorities"], "Id", "Name", Model.PriorityId))'></select>
    </div>

    <div class="mb-3">
        <label asp-for="AssignedToId" class="form-label">Asignar a</label>
        <select asp-for="AssignedToId" class="form-select" asp-items='@(ViewData["Users"] as SelectList)'>
            <option value="">-- Ninguno --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <input type="submit" value="Guardar" class="btn btn-primary" />
        <a asp-controller="Ticket" asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
